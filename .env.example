# Copy this file to .env and replace the your-... placeholders:  cp .env.example .env

# Tapo camera
# CAMERA_HOST: the camera's IP address (Tapo app: camera > Settings > Device Info).
# CAMERA_USER / CAMERA_PASS: the camera's "Camera Account" (Tapo app: camera > Settings >
# Advanced Settings > Camera Account). This is not your TP-Link cloud login.
CAMERA_HOST=your-camera-ip
CAMERA_USER=your-camera-account-username
CAMERA_PASS=your-camera-account-password
ONVIF_PORT=2020
RTSP_PORT=554
# stream1 = full quality (used for event pictures), stream2 = low quality (used for live view)
RTSP_STREAM=stream1
LIVE_STREAM=stream2

# OpenAI Decisions API key. Alternatively leave this empty and put the key in the file
# named by DECISIONS_KEY_FILE (default: decisionsapi.txt).
OPENAI_API_KEY=your-openai-api-key
DECISIONS_MODEL=gpt-6-luna
# A frame counts as showing a person at PERSON_MIN_PROB; a "using phone" / "no phone"
# verdict needs VERDICT_MIN_PROB, otherwise the event is marked "unclear".
PERSON_MIN_PROB=0.5
VERDICT_MIN_PROB=0.6

# Which camera event starts a capture: motion (any movement the Tapo reports), person (the
# camera's own person detection, not sent by every model), or auto (person if the camera
# offers it, otherwise motion). Pictures without a person are marked "no person".
TRIGGER_MODE=motion
# Pictures taken per event, SNAPSHOT_INTERVAL seconds apart; each one goes to the Decisions API.
SNAPSHOTS=3
SNAPSHOT_INTERVAL=1.5
# Minimum seconds between two automatic captures.
COOLDOWN_SECONDS=20
# Delete events older than this many days (0 keeps everything).
KEEP_DAYS=14

EVENTS_DIR=events
# The dashboard has no login, so it only listens locally: http://localhost:8765
WEB_HOST=127.0.0.1
WEB_PORT=8765
